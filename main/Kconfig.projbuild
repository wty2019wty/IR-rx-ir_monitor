menu "IR Monitor Configuration"

    config IR_MONITOR_IR_RX_GPIO
        int "IR receiver GPIO (VS1838B OUT)"
        default 4

    config IR_MONITOR_OLED_SDA_GPIO
        int "OLED I2C SDA GPIO"
        default 8

    config IR_MONITOR_OLED_SCL_GPIO
        int "OLED I2C SCL GPIO"
        default 9

    config IR_MONITOR_OLED_I2C_ADDR
        hex "OLED I2C device address (7-bit, without R/W bit)"
        default 0x3C

    config IR_MONITOR_OLED_I2C_CLK_HZ
        int "OLED I2C clock frequency (Hz)"
        default 400000

    config IR_MONITOR_BTN_UP_GPIO
        int "Button UP GPIO"
        default 39

    config IR_MONITOR_BTN_DOWN_GPIO
        int "Button DOWN GPIO"
        default 38

    config IR_MONITOR_BTN_OK_GPIO
        int "Button OK GPIO"
        default 37

    config IR_MONITOR_BTN_BACK_GPIO
        int "Button BACK GPIO"
        default 36

endmenu
